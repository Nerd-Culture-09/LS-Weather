/* Full-bleed contour wallpaper, fixed behind every page */
.ls-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  /* Painted while the image loads, matches its colour ramp */
  background: linear-gradient(180deg, #8e349b 0%, #a12e72 35%, #c42c2d 75%, #d12d1f 100%);
}

.ls-bg__img {
  display: block;
  width: 100%;
  height: 100%;
}

/* Gentle tint so white text keeps contrast over the busiest contours */
.ls-bg__veil {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(70, 12, 80, 0.2) 0%, rgba(70, 12, 80, 0) 45%, rgba(110, 10, 20, 0.1) 100%);
}
