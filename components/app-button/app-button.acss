.ls-btn {
  height: 54px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.ls-btn__text {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0.2px;
}

/* Solid white: the one opaque surface on screen, so the main action is obvious */
.ls-btn--primary {
  background: #ffffff;
  box-shadow: 0 10px 28px rgba(90, 8, 40, 0.32);
}

.ls-btn--primary .ls-btn__text {
  color: #a3172b;
}

.ls-btn--ghost {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.5);
}

.ls-btn--ghost .ls-btn__text {
  color: #ffffff;
}

.ls-btn--pressed {
  transform: scale(0.98);
  opacity: 0.86;
}

.ls-btn--disabled {
  opacity: 0.5;
}
