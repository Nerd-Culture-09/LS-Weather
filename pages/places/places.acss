.ls-places__head {
  display: flex;
  flex-direction: column;
  padding: 8px 4px 22px;
}

/* ---------- Search ---------- */

.ls-search {
  height: 52px;
  padding: 0 6px 0 14px;
  margin-bottom: 12px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.34);
  box-shadow: 0 12px 32px rgba(70, 6, 40, 0.22);
}

.ls-search__input {
  flex: 1;
  height: 100%;
  margin-left: 10px;
  font-size: 17px;
  color: #ffffff;
  background: transparent;
}

.ls-search__clear {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- Lists ---------- */

.ls-section-title {
  margin: 22px 4px 10px;
}

.ls-list {
  padding: 4px 0;
  overflow: hidden;
}

.ls-row {
  min-height: 62px;
  padding: 10px 6px 10px 14px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.ls-row:last-child {
  border-bottom: none;
}

/* A row that stands alone as its own card */
.ls-row--card {
  border-bottom: 1px solid rgba(255, 255, 255, 0.26);
  padding-right: 14px;
}

.ls-row--pressed {
  background: rgba(255, 255, 255, 0.1);
}

.ls-row__icon {
  width: 38px;
  height: 38px;
  margin-right: 12px;
  border-radius: 19px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
}

.ls-row__icon--accent {
  background: rgba(255, 255, 255, 0.92);
}

.ls-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ls-row__title,
.ls-row__subtitle {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ls-row__title {
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  color: #ffffff;
}

.ls-row__subtitle {
  font-size: 13px;
  line-height: 18px;
  color: rgba(255, 255, 255, 0.7);
}

.ls-row--card .ls-row__body {
  margin-right: 8px;
}

/* 44px tap target for the save toggle */
.ls-row__star {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ls-empty {
  padding: 18px 16px;
  font-size: 14px;
  line-height: 20px;
  text-align: center;
  color: rgba(255, 255, 255, 0.82);
}

.ls-empty--hint {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ls-empty__text {
  margin-left: 8px;
}

.ls-attribution {
  display: block;
  margin-top: 10px;
  text-align: center;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
}
